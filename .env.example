# Murmur Docker stack — AuthPlane (authserver) only.
# The app runs natively via `npm run dev -- --tunnel` (Alpic handles it).

# --- AuthPlane secrets (generated by start.sh if blank) ---
# openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=
# openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=

# --- Public URLs (set by start.sh, see below) ---
# PUBLIC_AUTH_URL = the cloudflared URL for :9000 (rotates on restart)
# PUBLIC_APP_URL  = the Alpic URL the dev server prints (stable)
PUBLIC_AUTH_URL=
PUBLIC_APP_URL=

# --- Demo users (idempotent; created by start.sh) ---
DEMO_USER_1_EMAIL=harsh@demo.io
DEMO_USER_1_PASSWORD=speedrun-demo
DEMO_USER_2_EMAIL=maya@demo.io
DEMO_USER_2_PASSWORD=speedrun-demo

# --- AuthPlane DPoP ---
# Bearer-only for the speedrun. Set to "true" to exercise DPoP proof-of-possession.
AUTHPLANE_DPOP_ENABLED=false
